%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 6a4d4ed0d54957640bf1f99ebf2dc728, type: 3}
  m_Name: Death3
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  lines:
  - speakerName: Sidney
    portrait: {fileID: -458423623252147687, guid: 9892a9fb231417f4c928fe8cd711111f, type: 3}
    text: "\u201CHey Lovie, what\u2019s your favorite genre of like\u2026 movies?\u201D"
    typingSound: {fileID: 8300000, guid: d1008ddac7f8ca941bff0618740cdb38, type: 3}
  - speakerName: Lovie
    portrait: {fileID: -755074056425189896, guid: 7ca14bf446cd1ed4db199d7399bf21d7, type: 3}
    text: "\u201CYou immediately strike me as a person who would be into romance
      or something cheesy like that.\u201D"
    typingSound: {fileID: 8300000, guid: 50dc94b23013f4c4b87c049728579203, type: 3}
  - speakerName: Sidney
    portrait: {fileID: -458423623252147687, guid: 9892a9fb231417f4c928fe8cd711111f, type: 3}
    text: "\u201CHEY WHO SAID CHEESE WAS BAD!?\u201D"
    typingSound: {fileID: 8300000, guid: d1008ddac7f8ca941bff0618740cdb38, type: 3}
  - speakerName: Lovie
    portrait: {fileID: -755074056425189896, guid: 7ca14bf446cd1ed4db199d7399bf21d7, type: 3}
    text: " \u201CNot saying cheese is bad! I actually love some good cheesy romance.\u201D"
    typingSound: {fileID: 8300000, guid: 50dc94b23013f4c4b87c049728579203, type: 3}
  - speakerName: Sidney
    portrait: {fileID: -458423623252147687, guid: 9892a9fb231417f4c928fe8cd711111f, type: 3}
    text: "\u201CWoah! I think you would like horror movies or something. You and
      I are more alike than I realized.\u201D"
    typingSound: {fileID: 8300000, guid: d1008ddac7f8ca941bff0618740cdb38, type: 3}
  - speakerName: Lovie
    portrait: {fileID: -755074056425189896, guid: 7ca14bf446cd1ed4db199d7399bf21d7, type: 3}
    text: "\u201CThere is more to a person than their surface, Sidney! I am a reminder
      of that very fact.\u201D"
    typingSound: {fileID: 8300000, guid: 50dc94b23013f4c4b87c049728579203, type: 3}
