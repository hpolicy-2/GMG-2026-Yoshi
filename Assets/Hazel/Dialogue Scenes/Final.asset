%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 6a4d4ed0d54957640bf1f99ebf2dc728, type: 3}
  m_Name: Final
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  lines:
  - speakerName: Sidney
    portrait: {fileID: -458423623252147687, guid: 9892a9fb231417f4c928fe8cd711111f, type: 3}
    text: "\u201CLovie\u2026\u201D"
    typingSound: {fileID: 8300000, guid: d1008ddac7f8ca941bff0618740cdb38, type: 3}
  - speakerName: Lovie
    portrait: {fileID: -755074056425189896, guid: 7ca14bf446cd1ed4db199d7399bf21d7, type: 3}
    text: "\u201CSid\u2026\u201D"
    typingSound: {fileID: 8300000, guid: 50dc94b23013f4c4b87c049728579203, type: 3}
  - speakerName: Sidney
    portrait: {fileID: -458423623252147687, guid: 9892a9fb231417f4c928fe8cd711111f, type: 3}
    text: "\u201CI\u2019ve\u2026 been meaning to ask you something for a while now.\u201D"
    typingSound: {fileID: 8300000, guid: d1008ddac7f8ca941bff0618740cdb38, type: 3}
  - speakerName: Lovie
    portrait: {fileID: -755074056425189896, guid: 7ca14bf446cd1ed4db199d7399bf21d7, type: 3}
    text: "\u201CSame\u2026 to be honest. I\u2019ve been way too scared to admit
      but\u2026\u201D"
    typingSound: {fileID: 8300000, guid: 50dc94b23013f4c4b87c049728579203, type: 3}
  - speakerName: Sidney
    portrait: {fileID: -458423623252147687, guid: 9892a9fb231417f4c928fe8cd711111f, type: 3}
    text: " \u201CBut what Love?\u201D"
    typingSound: {fileID: 8300000, guid: d1008ddac7f8ca941bff0618740cdb38, type: 3}
  - speakerName: Lovie
    portrait: {fileID: -755074056425189896, guid: 7ca14bf446cd1ed4db199d7399bf21d7, type: 3}
    text: "\u201CI-I\u2026 Can we say it at the same time? I\u2019m too scared\u2026
      and I don\u2019t know why.\u201D"
    typingSound: {fileID: 8300000, guid: 50dc94b23013f4c4b87c049728579203, type: 3}
  - speakerName: Sidney
    portrait: {fileID: -458423623252147687, guid: 9892a9fb231417f4c928fe8cd711111f, type: 3}
    text: "\u201CSure, Lovie! Anything to make you feel safe.\u201D"
    typingSound: {fileID: 8300000, guid: d1008ddac7f8ca941bff0618740cdb38, type: 3}
  - speakerName: Sidney and Lovie
    portrait: {fileID: 9032344321600866101, guid: 490475a97ab69224a9a5bfd9f701a10c, type: 3}
    text: "\u201CWILL YOU GO TO PROM WITH ME?\u201D"
    typingSound: {fileID: 8300000, guid: 42b5485fef5db9740bb79c9f77b639ad, type: 3}
  - speakerName: Sidney
    portrait: {fileID: -458423623252147687, guid: 9892a9fb231417f4c928fe8cd711111f, type: 3}
    text: "\u201CLovie!\u201D"
    typingSound: {fileID: 8300000, guid: d1008ddac7f8ca941bff0618740cdb38, type: 3}
  - speakerName: Lovie
    portrait: {fileID: -755074056425189896, guid: 7ca14bf446cd1ed4db199d7399bf21d7, type: 3}
    text: '"I..."'
    typingSound: {fileID: 8300000, guid: 50dc94b23013f4c4b87c049728579203, type: 3}
  - speakerName: Lovie
    portrait: {fileID: -755074056425189896, guid: 7ca14bf446cd1ed4db199d7399bf21d7, type: 3}
    text: "\u201CI *sniffle* would love to *sniffle*.\u201D"
    typingSound: {fileID: 8300000, guid: 50dc94b23013f4c4b87c049728579203, type: 3}
  - speakerName: Lovie
    portrait: {fileID: -755074056425189896, guid: 7ca14bf446cd1ed4db199d7399bf21d7, type: 3}
    text: "\u201CI never thought *sniffle* you would ask me *sniffle*\u201D"
    typingSound: {fileID: 8300000, guid: 50dc94b23013f4c4b87c049728579203, type: 3}
  - speakerName: Sidney
    portrait: {fileID: -458423623252147687, guid: 9892a9fb231417f4c928fe8cd711111f, type: 3}
    text: "\u201CI even got you some flowers Love\u2026\u201D"
    typingSound: {fileID: 8300000, guid: d1008ddac7f8ca941bff0618740cdb38, type: 3}
  - speakerName: Lovie
    portrait: {fileID: -755074056425189896, guid: 7ca14bf446cd1ed4db199d7399bf21d7, type: 3}
    text: "\u201CI\u2026*sniffle*  thank you.\u201D"
    typingSound: {fileID: 8300000, guid: 50dc94b23013f4c4b87c049728579203, type: 3}
